# Supabase project credentials (use the SERVICE ROLE key here — this
# worker runs server-side only and bypasses RLS intentionally).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Storage bucket where rendered images are uploaded.
STORAGE_BUCKET=renders

# Path to the Chromium binary inside the container (set automatically
# by the Dockerfile; override for local dev, e.g. on macOS:
# /Applications/Chromium.app/Contents/MacOS/Chromium)
CHROMIUM_PATH=/usr/bin/chromium

PORT=8787
