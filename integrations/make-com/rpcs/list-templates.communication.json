{
  "url": "/api/v1/templates",
  "method": "GET",
  "headers": {
    "Authorization": "Bearer {{connection.apiKey}}"
  },
  "response": {
    "iterate": "{{body.data}}",
    "output": {
      "value": "{{item.id}}",
      "label": "{{item.title}} — {{item.width}}x{{item.height}}{{if(item.is_preset, ' (preset)', '')}}"
    },
    "error": {
      "message": "[{{statusCode}}] {{body.error}}"
    }
  }
}
