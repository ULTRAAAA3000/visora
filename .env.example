# Supabase project URL and anon/public key — safe to expose client-side
# as long as Row Level Security is enabled on every table (it is, see
# supabase/migrations/0001_init.sql). Never put the service_role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# LemonSqueezy overlay checkout (Phase 4 billing). Leave unset and the
# Pricing/Billing "Upgrade" buttons show "Checkout coming soon" instead
# of failing. Fill in once the Pro/Agency products exist in your store:
#   VITE_LEMONSQUEEZY_STORE            store subdomain, e.g. "visora" for visora.lemonsqueezy.com
#   VITE_LEMONSQUEEZY_PRO_VARIANT_ID    Variant ID of the Pro monthly product
#   VITE_LEMONSQUEEZY_AGENCY_VARIANT_ID Variant ID of the Agency monthly product
VITE_LEMONSQUEEZY_STORE=
VITE_LEMONSQUEEZY_PRO_VARIANT_ID=
VITE_LEMONSQUEEZY_AGENCY_VARIANT_ID=
