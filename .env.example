# Supabase project URL and anon/public key — safe to expose client-side
# as long as Row Level Security is enabled on every table (it is, see
# supabase/migrations/0001_init.sql). Never put the service_role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
