# Supabase project URL and anon/public key — safe to expose client-side
# as long as Row Level Security is enabled on every table (it is, see
# supabase/migrations/0001_init.sql). Never put the service_role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Paddle overlay checkout (Phase 4 billing). Leave unset and the
# Pricing/Billing "Upgrade" buttons show "Checkout coming soon" instead
# of failing. Fill in once the Pro/Agency prices exist in Paddle:
#   VITE_PADDLE_CLIENT_TOKEN     public "Client-side token" from Paddle Dashboard -> Developer Tools -> Authentication
#   VITE_PADDLE_ENV              "sandbox" while testing against a Sandbox account, otherwise leave unset
#   VITE_PADDLE_PRO_PRICE_ID     Price ID (pri_...) of the Pro monthly price
#   VITE_PADDLE_AGENCY_PRICE_ID  Price ID (pri_...) of the Agency monthly price
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_ENV=
VITE_PADDLE_PRO_PRICE_ID=
VITE_PADDLE_AGENCY_PRICE_ID=

# The render Worker's public URL (custom domain or *.workers.dev), used
# by the dashboard's "Send test event" webhook button. Everything else
# in the dashboard talks only to Supabase directly, so this is the one
# var needed to let the frontend call the Worker's API at all.
VITE_RENDER_API_URL=

# Google Analytics 4 Measurement ID (looks like G-XXXXXXXXXX), from
# your GA4 property's Data Streams settings. Leave unset and no
# analytics script loads at all — nothing breaks, you just get no
# traffic data.
VITE_GA_MEASUREMENT_ID=
